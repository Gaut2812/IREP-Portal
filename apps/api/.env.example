# ---- IREP API environment (copy to .env) ----
ENVIRONMENT=development                 # development | production (production disables demo fallbacks)
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET_KEY=change-me-in-production
DEFAULT_COLLEGE_ID=col_demo_001
DATABASE_URL=sqlite+aiosqlite:///./irep.db   # PostgreSQL: postgresql+psycopg2://user:pass@host/irep

# Code execution (Screen 24)
JUDGE0_ADAPTER=fake                     # fake | judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
SUBMISSION_RATE_LIMIT_SECONDS=5

# AI reviewer (Screen 24/25)
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=5

# Live classes (Screen 07/08)
LIVE_CLASS_ADAPTER=fake                 # fake | teams (Master Plan) | bbb (legacy)
# Teams via Microsoft Graph, app-only. The tenant admin grants Calendars.ReadWrite,
# OnlineMeetings.Read.All, OnlineMeetingArtifact.Read.All and an application access policy.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
TEAMS_DEFAULT_ORGANIZER=                # used when a trainer has no trainers.teams_upn
TEAMS_REPORT_DELAY_SECONDS=600          # wait before pulling the attendance report
BBB_URL=http://localhost:8080/bigbluebutton
BBB_SECRET=

# Virtual labs (Screen 29)
LAB_ADAPTER=fake                        # fake | docker

# Translation (Screen 35)
TRANSLATE_ADAPTER=fake                  # fake | libretranslate
TRANSLATE_URL=http://localhost:5000

# Realtime + notifications
REALTIME_ADAPTER=inprocess              # inprocess | valkey
NOTIFY_ADAPTER=fake                     # fake | smtp | sms

# Identity: local (API JWT, dev) | keycloak (required in production)
AUTH_PROVIDER=local
KEYCLOAK_URL=http://localhost:8081      # as the browser sees it; the token issuer
KEYCLOAK_REALM=irep
KEYCLOAK_AUDIENCE=irep-api

# Outbox (SMS/email and other side effects run after commit)
OUTBOX_RUNNER=thread                    # thread (in the API, dev) | celery (apps/workers) | off
OUTBOX_POLL_SECONDS=2
OUTBOX_MAX_ATTEMPTS=5
CELERY_BROKER_URL=redis://localhost:6379/0   # Valkey

# Integrations
GITHUB_WEBHOOK_SECRET=
