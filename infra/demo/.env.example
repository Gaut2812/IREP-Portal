# IREP demo settings. Copy to .env (never commit it):  cp .env.example .env && chmod 600 .env
APP_DOMAIN=demo.example.in            # DNS A record pointing at this server
ACME_EMAIL=you@example.in             # certificate expiry notices
POSTGRES_PASSWORD=CHANGE_ME           # openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME              # openssl rand -hex 32
# Password gate in front of the whole demo (recommended). Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-gate-password'
# and paste it inside the single quotes below.
DEMO_GATE=gate                        # gate | open
DEMO_GATE_USER=irep
DEMO_GATE_HASH=''                     # keep the single quotes: the hash contains $ signs
DEMO_GATE_TOKEN=CHANGE_ME             # openssl rand -hex 32 (the cookie set after the gate)
