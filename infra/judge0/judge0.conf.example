# Copy to judge0.conf (git-ignored) and change every CHANGE_ME. Full option list: Judge0 CE 1.13.1 judge0.conf.

# Clients must send this header and token (the API sends JUDGE0_AUTH_HEADER / JUDGE0_AUTH_TOKEN)
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=CHANGE_ME_long_random_token

# Student code gets no network, and requests may not turn it on
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false

# Limits a request may ask for (the API asks for the problem's limits, terminal runs up to 5 s)
CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=10
WALL_TIME_LIMIT=15
MAX_WALL_TIME_LIMIT=20
MEMORY_LIMIT=262144
MAX_MEMORY_LIMIT=524288
MAX_FILE_SIZE=1024
MAX_PROCESSES_AND_OR_THREADS=60
ENABLE_BATCHED_SUBMISSIONS=true

# Judge0's own database and queue (containers in docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME_postgres
