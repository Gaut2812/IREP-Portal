# Copy to .env on the lab node. Never commit .env.
# Shared secret between the portal (JUPYTERHUB_API_TOKEN) and the hub's irep-labs service.
IREP_LABS_SERVICE_TOKEN=change-me-openssl-rand-hex-32
# Registry prefix for the profile images (default: images built locally as irep/lab-*:1)
LAB_IMAGE_REGISTRY=irep
# 1 only on a node with the Sysbox runtime installed (enables the Docker & Kubernetes profile)
LAB_SYSBOX=0
# Address cAdvisor's port binds to (the portal reads it as LAB_METER_URL); keep it private
METER_BIND=127.0.0.1
