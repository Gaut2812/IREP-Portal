# IREP pilot: copy to infra/prod/.env (never commit it), fill in every CHANGE_ME, then `chmod 600 .env`.
# Generate secrets with:  openssl rand -hex 32     (hex only: these go into URLs unescaped)
# Values marked "fixed" are set by docker-compose.yml and listed here only so nothing is a surprise.

# --- Domains and TLS ------------------------------------------------------------------------
APP_DOMAIN=portal.example.in            # the portal; DNS A record -> this VM
ID_DOMAIN=id.example.in                 # Keycloak sign-in; DNS A record -> this VM
ACME_EMAIL=CHANGE_ME@example.in         # Let's Encrypt expiry notices
KC_ADMIN_ALLOW_IPS=203.0.113.10/32      # your public IP(s), space-separated, for the Keycloak admin console
IREP_VERSION=local                      # image tag; bump per release (git short sha) to keep rollbacks

# --- Database and broker (secrets) ----------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME             # app database user "irep"
KC_DB_PASSWORD=CHANGE_ME                # Keycloak database user "keycloak"
VALKEY_PASSWORD=CHANGE_ME               # Celery broker
# fixed: DATABASE_URL, CELERY_BROKER_URL are built from the passwords above

# --- Identity (secrets) ---------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME                # signs parent OTP sessions and signed media links (>= 32 chars)
KEYCLOAK_ADMIN_USER=irep-admin          # Keycloak master-realm admin (console + the API's user sync)
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_REALM=irep
KEYCLOAK_AUDIENCE=irep-api
KEYCLOAK_INVITE_EMAIL=true              # college onboarding emails the representative a set-password link
# fixed: AUTH_PROVIDER=keycloak, KEYCLOAK_URL=https://ID_DOMAIN, KEYCLOAK_JWKS_URL, KEYCLOAK_ADMIN_URL
GITHUB_WEBHOOK_SECRET=CHANGE_ME         # Screen 22 project webhooks

# --- Email (required: parent sign-in codes, notices, Keycloak invites) -----------------------
NOTIFY_ADAPTER=live
SMTP_HOST=smtp-relay.brevo.com          # any SMTP provider; Brevo free tier = 300 emails/day
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM="IREP Portal <no-reply@example.in>"   # a sender verified with your provider (SPF/DKIM)

# --- Parent sign-in code and SMS (paid switch, OFF by default) -----------------------------
PARENT_OTP_CHANNEL=email                # email (free) | sms (needs SMS_PROVIDER fast2sms or msg91)
SMS_PROVIDER=off                        # off: SMS notices go by email instead | fast2sms | msg91
FAST2SMS_API_KEY=                       # secret; Fast2SMS dashboard > Dev API. Only when SMS_PROVIDER=fast2sms
FAST2SMS_ROUTE=q                        # q = Quick SMS (free text) for notices
FAST2SMS_OTP_ROUTE=q                    # q: code inside our message | otp: Fast2SMS OTP route (code only)
MSG91_AUTH_KEY=                         # only when SMS_PROVIDER=msg91
MSG91_TEMPLATE_ID=                      # DLT-approved notice template with a ##message## variable
MSG91_OTP_TEMPLATE_ID=                  # DLT-approved OTP template with an ##otp## variable

# --- Live classes: Microsoft Teams (docs/deploy/TEAMS_SETUP.md) ------------------------------
LIVE_CLASS_ADAPTER=teams                # until your M365 admin consents: remove and add live_classes below
GRAPH_TENANT_ID=CHANGE_ME
GRAPH_CLIENT_ID=CHANGE_ME
GRAPH_CLIENT_SECRET=CHANGE_ME           # expires: put the date in your calendar and rotate before it
TEAMS_DEFAULT_ORGANIZER=CHANGE_ME@yourcollege.onmicrosoft.com
TEAMS_REPORT_DELAY_SECONDS=900

# --- Outside the pilot: demo adapters kept on purpose ---------------------------------------
# Coding Lab (Judge0), Virtual Labs / Cyber Range and AI Study Buddy keep their demo adapters.
# Add live_classes here only if Teams is not ready yet (in-portal classroom, no video).
ALLOW_DEMO_ADAPTERS=judge0,labs,study_buddy
JUDGE0_ADAPTER=fake
LAB_ADAPTER=fake
STUDY_BUDDY_ADAPTER=fake
TRANSLATE_ADAPTER=fake

# --- Files ----------------------------------------------------------------------------------
STORAGE_ADAPTER=local                   # files on the "uploads" volume; s3 is an interface for later
# fixed: STORAGE_DIR=/data/uploads

# --- Tenancy --------------------------------------------------------------------------------
DEFAULT_COLLEGE_ID=col_pilot_001        # only a fallback; colleges are created on Screen 45

# --- Backups (infra/prod/backup.sh) ---------------------------------------------------------
BACKUP_DIR=/var/backups/irep            # on this VM, kept 7 days
BACKUP_KEEP_DAYS=7
BACKUP_AGE_RECIPIENT=CHANGE_ME              # age PUBLIC key (age1...); the private key stays off this server (DEPLOY.md, "Backup key")
BACKUP_REMOTE=                          # second location, e.g. "b2:irep-backups" (rclone) or "user@host:/backups/irep" (rsync over ssh)
