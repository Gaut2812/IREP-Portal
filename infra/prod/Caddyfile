# Caddy gets and renews Let's Encrypt certificates for both names on its own.
# Needs DNS A records for APP_DOMAIN and ID_DOMAIN pointing at this VM, with ports 80 and 443 open.
{
	email {$ACME_EMAIL}
	order rate_limit before basicauth
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	# uploads: 25 MB, except interview recordings (up to 500 MB, scanned by ClamAV in the API)
	@recording path /api/v1/trainer/interviews/*/recording
	@not_recording not path /api/v1/trainer/interviews/*/recording
	request_body @recording {
		max_size 600MB
	}
	request_body @not_recording {
		max_size 25MB
	}
	# Per-IP limit on sign-in and parent codes, on top of the API's own limits and Keycloak's
	# per-account lockout. Generous on purpose: a college lab shares one IP for a whole class.
	rate_limit {
		zone signin_per_ip {
			match {
				method POST
				path /api/v1/auth/login /api/v1/auth/parent/otp/request /api/v1/auth/parent/otp/verify
			}
			key {remote_host}
			events {$SIGNIN_RATE_PER_MIN:120}
			window 1m
		}
	}
	# API (REST + WebSockets under /api/v1/ws/...) and signed media links
	@api path /api/* /media/* /health
	handle @api {
		reverse_proxy api:8000
	}
	# The interactive API docs stay off the public internet
	@docs path /docs* /redoc* /openapi.json
	handle @docs {
		respond 404
	}
	handle {
		reverse_proxy web:3000
	}
}

{$ID_DOMAIN} {
	import security_headers
	# Admin console and the master realm only from KC_ADMIN_ALLOW_IPS (your office/home IP).
	# The API reaches Keycloak's admin API inside Docker (http://keycloak:8080), not through here.
	@kcadmin {
		path /admin* /realms/master*
		not remote_ip {$KC_ADMIN_ALLOW_IPS}
	}
	respond @kcadmin 404
	# Keycloak's health and metrics stay internal
	@kcinternal path /health* /metrics*
	respond @kcinternal 404
	# Per-IP limit on the sign-in form (password, OTP, set-password), on top of Keycloak's per-account lockout
	rate_limit {
		zone kc_signin_per_ip {
			match {
				method POST
				path /realms/*/login-actions/*
			}
			key {remote_host}
			events {$SIGNIN_RATE_PER_MIN:120}
			window 1m
		}
	}
	reverse_proxy keycloak:8080
}
